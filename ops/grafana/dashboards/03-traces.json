{
  "uid": "pgllens-traces",
  "title": "Traces (Tempo)",
  "tags": ["pgllens", "traces", "tempo"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "timezone": "",
  "templating": { "list": [] },
  "annotations": {
    "list": [
      {
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "builtIn": 1,
        "datasource": { "type": "datasource", "uid": "-- Grafana --" }
      }
    ]
  },
  "panels": [
    {
      "id": null,
      "title": "About",
      "type": "text",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Distributed traces for **pgllens**, stored in Tempo. Each row is an HTTP request trace (root span from the ASGI instrumentation). Only visible when `OTEL_ENABLED=true` and the server was started with an OTLP endpoint pointed at Tempo (`docker compose --profile observe up`)."
      }
    },
    {
      "id": null,
      "title": "Recent traces",
      "description": "Most recent pgllens request traces. Click a traceID to open the waterfall.",
      "type": "table",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 4 },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"pgllens\"}",
          "tableType": "traces",
          "limit": 30
        }
      ]
    },
    {
      "id": null,
      "title": "Error traces",
      "description": "Traces containing at least one span with status=error. Empty is healthy.",
      "type": "table",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 15 },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"pgllens\" && status=error}",
          "tableType": "traces",
          "limit": 20
        }
      ]
    },
    {
      "id": null,
      "title": "Slow traces (> 500ms)",
      "description": "Traces whose root/any span exceeds 500ms -- useful for spotting a slow query or a slow explain.",
      "type": "table",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 15 },
      "options": { "showHeader": true, "cellHeight": "sm" },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "filterable": true } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{resource.service.name=\"pgllens\" && duration>500ms}",
          "tableType": "traces",
          "limit": 20
        }
      ]
    }
  ]
}
