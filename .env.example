# PostgreSQL connection (postgresql:// URL; the DSN names the one database served)
DATABASE_URL=postgresql://lens:password@db.example.com:5432/mydb

# Refuse to start unless DATABASE_URL pins TLS to the database. Required for any
# internet deployment: a read-only lens still ships the client's data over the wire.
# DB_REQUIRE_VERIFY_FULL=true
# DATABASE_URL=postgresql://pgllens:pw@db.example.com:5432/mydb?sslmode=verify-full&sslrootcert=/certs/root.crt

# Exposed schemas inside that database (comma-separated, at least one required)
EXPOSED_SCHEMAS=public
# DEFAULT_SCHEMA=public

# MCP Server (port lever is MCP_PORT, in the Play/Solo block below)
HOST=0.0.0.0

# Query limits
QUERY_TIMEOUT_MS=30000
MAX_ROWS=1000
# Comma-separated column-name patterns (% = any run, _ literal, case-insensitive) masked as [masked] in query/get_sample_data output.
# Default: %password%,%passwd%,%secret%,%api_key%,ssn,%_ssn,ssn_%,%_ssn_%,token,%_token,%_token_% -- a value replaces it, `off` disables.
# REDACT_COLUMNS=off
# REDACT_COLUMNS=%pin%,%card%
SCHEMA_REFRESH_INTERVAL_MS=300000
# Reject queries whose estimated plan cost exceeds this (planner cost units); unset = off.
# MAX_ESTIMATED_COST=100
# Inbound MCP tool calls allowed per client per minute. 0 = off.
TOOL_RATE_LIMIT_PER_MINUTE=120
# Planner cost units one client may spend per minute (see MAX_ESTIMATED_COST).
# Unset = off. Meaningful only alongside a shared store when running replicas.
# TOOL_COST_BUDGET_PER_MINUTE=10000
# In-flight tool calls per client; stops one client taking the whole pool. 0 = off.
# MAX_CONCURRENT_CALLS_PER_CLIENT=4

# Domain context (optional)
# Provide either inline text or a file path, but not both.
# DOMAIN_CONTEXT=This is a warehouse management database
# DOMAIN_CONTEXT_FILE=/path/to/domain-context.md   (start from the ops/context.md template)

# Logging and audit trail
LOG_LEVEL=INFO
LOG_FORMAT=json
# Path to the append-only audit JSONL trail. Unset disables auditing entirely.
# In compose this is the only writable path under the container's read-only root.
# Alloy tails /audit/audit.jsonl inside its own container (the same volume, mounted
# read-only), so changing this path also requires editing ops/alloy/config.alloy.
# AUDIT_LOG_FILE=/data/audit/audit.jsonl

# Ship the audit trail off-box to a UDP syslog collector, in addition to (or
# instead of) AUDIT_LOG_FILE. The compose stack already ships the JSONL to Loki
# via Alloy; use this when PgLLens does not run in that stack.
# AUDIT_SYSLOG=logs.example.com:514

# Audit sink when no file/syslog is set: stdout (Play tier). true = also stdout
# alongside the file; false = never.
# AUDIT_STDOUT=
# Size-based rotation of AUDIT_LOG_FILE. 0 = never rotate.
# AUDIT_LOG_MAX_BYTES=100000000
# AUDIT_LOG_BACKUPS=10

# =============================================================================
# Deployment tiers (docs/DEPLOY.md#compose-and-tiers). Each tier is a superset of the
# one above it. A blank file plus DATABASE_URL boots Play and Solo.
# =============================================================================

# --- Compose file selection (one-time, per machine) ----------------------------
# Compose reads COMPOSE_FILE and COMPOSE_PROFILES from this file, so the everyday
# commands are `docker compose up -d --build` (dev) and
# `docker compose pull && docker compose up -d` (prod). Uncomment one COMPOSE_FILE:
# dev: build the image from this checkout
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml:ops/demo/docker-compose.yml
# prod: pull ghcr.io/dmdufresne/pgllens:${PGLLENS_VERSION}; no source tree needed
# COMPOSE_FILE=docker-compose.yml:ops/demo/docker-compose.yml
# Separator is `:` when docker runs on Linux/macOS and `;` for the Windows docker.exe,
# including from Git Bash (or set COMPOSE_PATH_SEPARATOR). Windows dev line:
# COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml;ops/demo/docker-compose.yml
# Replaces the `--profile` flags. Drop `infra` on Docker Desktop; add `tunnel` as needed.
# COMPOSE_PROFILES=observe,infra

# --- Play / Solo: the app itself ----------------------------------------------
# Image tag compose pulls (ghcr.io/dmdufresne/pgllens). Also used by `docker run`.
# PGLLENS_VERSION=2.0.0
# /metrics is on by default; it is the same exposure class as /health. This is
# the app's own default (metrics_enabled=true in config.py), not a compose-only
# override -- set it to false to turn the endpoint off in any tier.
# METRICS_ENABLED=true
# Traces: provider on, export to OTEL_EXPORTER_OTLP_ENDPOINT. Any OTLP/gRPC
# collector works, not only the compose Tempo. On by default; an unreachable
# collector is logged once per 10m, not an error (Solo tier).
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
# Bind for the app port. Loopback unless a LAN/no-proxy deployment needs it open.
# APP_BIND=127.0.0.1
# MCP_PORT=3000

# --- Observed: profile observe -------------------------------------------------
# Required for the observe profile.
# GRAFANA_ADMIN_PASSWORD=change-me
# Bind for Grafana (:3001), Prometheus (:9090), Alertmanager (:9093).
# ADMIN_BIND=127.0.0.1
# Retention levers.
# PROM_RETENTION_TIME=30d
# PROM_RETENTION_SIZE=2GB
# LOKI_RETENTION=2160h
# TEMPO_RETENTION=168h
# Ship metrics to a central Prometheus as well (enterprise "plugs into ours").
# PROM_REMOTE_WRITE_URL=https://prometheus.example.com/api/v1/write
# Compose project name. Alloy discovers stack containers by the
# com.docker.compose.project label, so set this if you run compose from a
# directory that is not named `pgllens` (or with `-p`).
# COMPOSE_PROJECT_NAME=pgllens

# --- Production: profiles observe,infra ----------------------------------------
# Slack incoming webhook. Unset = alerts visible in the UI only, nothing leaves the box.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
# postgres_exporter TLS mode when DATABASE_URL carries no sslmode (lib/pq would otherwise
# require TLS, and it has no `prefer`). An sslmode in the DSN wins over this.
# POSTGRES_EXPORTER_SSLMODE=disable

# --- tunnel profile (any tier) ------------------------------------------------
# TUNNEL_TOKEN=
# Set true ONLY behind a proxy you control that OVERWRITES X-Forwarded-For.
# TRUST_PROXY_HEADERS=false

# OAuth (optional; see docs/DEPLOY.md#authentication)
# MCP_OAUTH_ENABLED=true
# MCP_AUTH_PASSWORD=change-me
# Must be set explicitly for any deployment behind a reverse proxy or on a
# non-default port -- see docs/DEPLOY.md#reverse-proxy.
# EXTERNAL_BASE_URL=https://pgllens.example.com
# MCP_OAUTH_TOKEN_EXPIRES_IN=604800
# MCP_RATE_LIMIT_ATTEMPTS=5
# MCP_RATE_LIMIT_WINDOW_MS=900000

# --- Okta resource-server mode (see docs/OKTA.md) ---
# PgLLens validates tokens minted by the client's Okta tenant and serves no
# /oauth/* routes of its own. Requires Okta API Access Management (a paid
# add-on) -- the Org authorization server cannot mint a custom audience.
# MCP_AUTH_MODE=okta
# OKTA_ISSUER=https://your-tenant.okta.com/oauth2/ausXXXXXXXXXXXX
# OKTA_AUDIENCE=api://pgllens
# Only for an internal JWKS mirror; defaults to ${OKTA_ISSUER}/v1/keys.
# OKTA_JWKS_URL_OVERRIDE=

# Shared limits and tokens across replicas (requires pgllens[redis]).
# Unset = in-memory, single process: fine for one container, wrong behind a
# load balancer (each replica would grant the full rate limit).
# REDIS_URL=redis://redis:6379/0
